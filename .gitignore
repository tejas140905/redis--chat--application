# ==============================================================================
# Freightfox Chat Application — ignore rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Build output (Maven / Gradle / Java)
# ------------------------------------------------------------------------------
target/
build/
out/
bin/
*.class
*.jar
*.war
*.ear
*.nar
# Keep the Maven wrapper jar, which must be committed for reproducible builds.
!.mvn/wrapper/maven-wrapper.jar

# Maven release/build metadata
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# JVM crash artefacts
hs_err_pid*
replay_pid*
*.hprof

# ------------------------------------------------------------------------------
# Secrets and local configuration — never commit these
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
application-local.yml
application-local.properties
application-secret.*
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ------------------------------------------------------------------------------
# IDE and editor
# ------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath
.apt_generated/
.sts4-cache/
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Operating system noise
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------------------------------------------
# Logs, runtime state and local data
# ------------------------------------------------------------------------------
*.log
*.log.*
logs/
*.pid
*.seed

# ------------------------------------------------------------------------------
# Tests and coverage reports
# ------------------------------------------------------------------------------
surefire-reports/
failsafe-reports/
test-results/
jacoco.exec
*.exec
site/

# ------------------------------------------------------------------------------
# Node.js (optional tooling: Newman, npx)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
coverage/

# ------------------------------------------------------------------------------
# Docker and local overrides
# ------------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml
.docker/

# ------------------------------------------------------------------------------
# Miscellaneous / backups
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
*.rej
*.zip
*.tar
*.tar.gz
