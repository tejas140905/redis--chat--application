      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/chatapp/chatrooms/{{roomId}}/messages",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chatapp", "chatrooms", "{{roomId}}", "messages"]
        }
      }
    }
  ]
